# ---------------------------------------------------------------
# Hybrid Party Show — environment template. Copy to `.env`.
# Never commit real credentials.
# ---------------------------------------------------------------

# Postgres (docker compose maps it to localhost:5433).
# Leave DATABASE_URL empty to run the server in in-memory mode (no persistence; good for quick play/tests).
DATABASE_URL=postgresql://hps:hps_dev_password@localhost:5433/hybrid_party_show

# Server
PORT=4000
# Comma-separated list of web origins allowed to talk to the server.
WEB_ORIGIN=http://localhost:3000
# HMAC secret used to sign spectator identities. Use a long random value in production.
SESSION_SECRET=change-me-to-a-long-random-string
# Seconds a disconnected player keeps their seat.
RECONNECT_WINDOW_SECONDS=120
# Multiplies every game timer (1 = normal). E2E tests use a small value.
GAME_TIMER_SCALE=1

# Web
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Seed: creates an administrator account when both are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Payments.
# PAYMENT_MODE=mock    -> local development; purchases complete through a simulated, signed webhook.
# PAYMENT_MODE=razorpay -> requires all three Razorpay values below. Production refuses to start
#                          in mock mode, and mock entitlements are ignored when NODE_ENV=production.
PAYMENT_MODE=mock
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
